{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun --watch --env-file=../../.env run src/index.ts & tsc --watch",
		"type-check": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "bun --env-file=../../.env x drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
		"db:studio": "bun --env-file=../../.env x drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1121.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.10.8",
		"postgres": "^3.4.9",
		"shared": "workspace:*",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10"
	}
}
