# Copy to .env beside this file: `cp project/.env.example project/.env`
#
# One file serves both sides of development: the server reads it for its own configuration,
# and Docker Compose reads it for the services it starts, so the credentials cannot drift
# apart. Everything here has a working default baked into the Compose files, so the stack
# comes up without a .env — the file exists so you can change ports or point the server at
# something other than localhost.
#
# In deployment these are ordinary environment variables. Nothing else changes: the database
# and the object store are always opaque endpoints behind connection strings (PLAN.md §4.1).

# --- Server ---------------------------------------------------------------------------

PORT=3000

# Postgres 18 or later — primary keys use the built-in uuidv7() (PLAN.md §5.2).
DATABASE_URL=postgres://dorf:dorf@localhost:5432/dorf_archiv

# Which Postgres text search configuration to use for German (PLAN.md §4.3).
#   german_hunspell — full quality, splits compounds: Kirche finds Dorfkirche.
#                     Provided by postgres/, which carries the de_DE dictionary.
#   german          — stock Postgres, stemming only. The fallback on hosts that cannot
#                     grant filesystem access to $SHAREDIR/tsearch_data/.
TEXT_SEARCH_CONFIG=german_hunspell

# --- Object storage (S3-compatible; MinIO in development) -------------------------------

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dorf-archiv
S3_ACCESS_KEY_ID=dorf
S3_SECRET_ACCESS_KEY=dorf-dev-secret
# MinIO and most self-hosted S3 implementations serve path-style URLs only.
S3_FORCE_PATH_STYLE=true

# --- Docker Compose -------------------------------------------------------------------
# Read by project/compose.dev.yml. The credentials above must match these.

POSTGRES_USER=dorf
POSTGRES_PASSWORD=dorf
POSTGRES_DB=dorf_archiv
POSTGRES_PORT=5432
# Which interface the backing services are published on. Loopback by default so that the
# whole-stack deployment does not expose Postgres and MinIO to the network.
BIND_ADDRESS=127.0.0.1
S3_PORT=9000
S3_CONSOLE_PORT=9001

# The pgAdmin login. Development-only credentials; the console is bound to loopback.
PGADMIN_EMAIL=admin@dorf-archiv.test
PGADMIN_PASSWORD=dorf-dev-secret
PGADMIN_PORT=5050
APP_PORT=3000
CLIENT_PORT=8080

# --- Client ---------------------------------------------------------------------------

VITE_SERVER_URL=http://localhost:3000

# --- Reverse proxy (the full stack's single entry point) ---------------------------------
# Hostnames are derived from PROXY_HOST: the client on the bare name, the API on api.<host>,
# pgAdmin on db.<host>. Subdomains of `localhost` resolve to loopback in browsers; on
# Windows a hosts entry may be needed for command-line tools.
PROXY_HOST=localhost
PROXY_PORT=8000
