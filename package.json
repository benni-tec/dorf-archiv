{
	"name": "dorf-archiv",
	"version": "0.5.1",
	"description": "A community archive for a village history — map, timeline, people and places.",
	"author": "benni-tec",
	"license": "MIT",
	"packageManager": "bun@1.2.4",
	"workspaces": [
		"./project/server",
		"./project/client",
		"./project/shared"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:client": "turbo dev --filter=client",
		"dev:server": "turbo dev --filter=server",
		"dev:infra": "bun scripts/dev-infra.ts",
		"dev:infra:up": "bun scripts/compose.ts dev up -d",
		"dev:infra:down": "bun scripts/compose.ts dev down",
		"compose:up": "bun scripts/compose.ts full up -d --build",
		"compose:down": "bun scripts/compose.ts full down",
		"db:generate": "bun run --filter server db:generate",
		"db:migrate": "bun run --filter server db:migrate",
		"db:studio": "bun run --filter server db:studio",
		"build": "turbo build",
		"build:client": "turbo build --filter=client",
		"build:server": "turbo build --filter=server",
		"lint": "biome lint .",
		"type-check": "turbo type-check",
		"test": "turbo test && bun test scripts",
		"postinstall": "turbo build --filter=shared --filter=server",
		"format": "biome format . --write"
	},
	"keywords": [
		"archive",
		"village",
		"history",
		"bun",
		"hono",
		"react"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"bun-types": "latest",
		"turbo": "^2.6.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"hono": "^4.13.5"
	}
}
