* text=auto eol=lf

# These are read by Linux containers and break on CRLF, whatever the checkout platform.
*.sh              text eol=lf
Dockerfile        text eol=lf
project/postgres/**       text eol=lf
project/server/Dockerfile text eol=lf

# Drizzle regenerates a full schema snapshot per migration; nobody reviews these by hand.
project/server/drizzle/meta/*.json linguist-generated=true
